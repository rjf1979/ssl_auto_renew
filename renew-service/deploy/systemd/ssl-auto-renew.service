[Unit]
Description=SSL Auto Renew
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
Environment=ALICLOUD_RAM_ROLE=resume-askcode
ExecStart=/usr/local/bin/sslctl renew --config /etc/ssl-auto-renew/config.yaml
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ssl-auto-renew /etc/ssl-auto-renew/certs /etc/ssl-auto-renew/secrets

[Install]
WantedBy=multi-user.target
